[Unit]
Description=CoffeeBar Controller
After=network.target

[Service]
Type=simple
User=jeffreybernath
WorkingDirectory=/home/jeffreybernath/Coffee_Controller/Pi_Coffee
ExecStart=/home/jeffreybernath/Coffee_Controller/Pi_Coffee/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
