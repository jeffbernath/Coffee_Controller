{
  "protocol_version": 1,
  "serial": {
    "baud_rate": 115200,
    "heartbeat_ms": 1000,
    "offline_timeout_ms": 5000
  },
  "io": [
    {
      "id": 1,
      "name": "LOAD_CELL_1_G",
      "type": "load_cell",
      "direction": "input",
      "data_type": "float",
      "units": "g",
      "sample_rate_ms": 10,
      "report_rate_ms": 100,
      "report": "periodic",
      "driver": "external_load_cell_adc",
      "channel": 1,
      "min": -5000.0,
      "max": 5000.0,
      "gui": {
        "label": "Load Cell 1",
        "group": "load_cells",
        "widget": "value",
        "": 1,
        "show": true
      },
      "handler": "load_cell"
    },
    {
      "id": 2,
      "name": "LOAD_CELL_2_G",
      "type": "load_cell",
      "direction": "input",
      "data_type": "float",
      "units": "g",
      "sample_rate_ms": 10,
      "report_rate_ms": 100,
      "report": "periodic",
      "driver": "external_load_cell_adc",
      "channel": 2,
      "min": -5000.0,
      "max": 5000.0,
      "gui": {
        "label": "Load Cell 2",
        "group": "load_cells",
        "widget": "value",
        "decimals": 1,
        "show": true
      },
      "handler": "load_cell"
    },
    {
      "id": 3,
      "name": "DIGITAL_INPUT_1",
      "type": "digital",
      "direction": "input",
      "data_type": "bool",
      "pin": 14,
      "active_level": "low",
      "pull": "up",
      "sample_rate_ms": 20,
      "report": "on_change",
      "gui": {
        "label": "Digital Input 1",
        "group": "inputs",
        "widget": "status",
        "true_text": "ON",
        "false_text": "OFF",
        "show": true
      },
      "handler": "gpio"
    },
    {
      "id": 4,
      "name": "LED_ENABLE",
      "type": "digital",
      "direction": "output",
      "data_type": "bool",
      "resource": "onboard_led",
      "pin": 25,
      "active_level": "high",
      "default": false,
      "safe_state": false,
      "report": "on_change",
      "gui": {
        "label": "LED",
        "group": "outputs",
        "widget": "toggle",
        "show": true
      },
      "handler": "led_enable"
    },
    {
      "id": 5,
      "name": "LED_BLINK_RATE_HZ",
      "type": "analog",
      "direction": "output",
      "data_type": "float",
      "resource": "onboard_led",
      "units": "Hz",
      "min": 0.0,
      "max": 10.0,
      "step": 0.1,
      "default": 1.0,
      "safe_state": 0.0,
      "report": "on_change",
      "gui": {
        "label": "LED Blink Rate",
        "group": "outputs",
        "widget": "slider_number",
        "decimals": 1,
        "show": true
      },
      "handler": "led_blink_rate"
    },
    {
      "id": 6,
      "name": "LED_PWM_PERCENT",
      "type": "pwm",
      "direction": "output",
      "data_type": "float",
      "resource": "onboard_led",
      "pin": 25,
      "units": "%",
      "pwm_frequency_hz": 1000,
      "min": 0.0,
      "max": 100.0,
      "step": 1.0,
      "default": 100.0,
      "safe_state": 0.0,
      "report": "on_change",
      "gui": {
        "label": "LED Intensity",
        "group": "outputs",
        "widget": "slider_number",
        "decimals": 0,
        "show": true
      },
      "handler": "led_pwm"
    },
    {
      "id": 7,
      "name": "TARE_BOTH",
      "type": "action",
      "direction": "command",
      "data_type": "none",
      "handler": "tare_all",
      "gui": {
        "label": "TARE BOTH",
        "group": "load_cells",
        "widget": "button",
        "show": true
      }
    },
    {
      "id": 8,
      "name": "BOILER_TEMP_C",
      "type": "analog",
      "direction": "input",
      "data_type": "float",
      "units": "°C",
      "sample_rate_ms": 250,
      "report_rate_ms": 500,
      "report": "periodic",
      "driver": "max31865",
      "min": -200.0,
      "max": 850.0,
      "gui": {
        "label": "Boiler Temperature",
        "group": "temperature",
        "widget": "temperature",
        "decimals": 1,
        "show": true
      },
      "handler": "max31865_temperature"
    },
    {
      "id": 9,
      "name": "BOILER_RTD_OHMS",
      "type": "analog",
      "direction": "input",
      "data_type": "float",
      "units": "Ω",
      "sample_rate_ms": 250,
      "report_rate_ms": 500,
      "report": "periodic",
      "driver": "max31865",
      "min": 0.0,
      "max": 500.0,
      "gui": {
        "label": "RTD Resistance",
        "group": "temperature",
        "widget": "sensor_value",
        "decimals": 2,
        "show": true
      },
      "handler": "max31865_resistance"
    },
    {
      "id": 10,
      "name": "BOILER_RTD_FAULT",
      "type": "analog",
      "direction": "input",
      "data_type": "int",
      "sample_rate_ms": 250,
      "report_rate_ms": 500,
      "report": "periodic",
      "driver": "max31865",
      "min": 0,
      "max": 255,
      "gui": {
        "label": "MAX31865 Status",
        "group": "temperature",
        "widget": "fault_status",
        "decimals": 0,
        "show": true
      },
      "handler": "max31865_fault"
    }
  ]
}
